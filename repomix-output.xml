                    (
                        run_id,
                        k.keyword,
                        k.source,
                        k.cluster_id,
                        k.intent.value,
                        k.city,
                        k.gsc_clicks,
                        k.gsc_impressions,
                        k.gsc_ctr,
                        k.gsc_position,
                    )
                    for k in sorted(keywords, key=lambda item: (item.keyword, item.source))
                ],
            )

    def load_keywords(self, run_id: str) -> list[Keyword]:
        rows = self.conn.execute(
            "SELECT * FROM keywords WHERE run_id = ? ORDER BY keyword, source", (run_id,)
        ).fetchall()
        return [
            Keyword(
                keyword=row["keyword"],
