    drafts = sorted((tmp_path / "out" / "agent-drafts" / "drafts").glob("*.md"))
    assert len(drafts) == 3
    events = read_trace(tmp_path / "logs" / "trace.jsonl")
    assert sum(e.get("kind") == "compliance_pass" for e in events) == 3
