        def audit(url, max_pages=20):
            captured["url"] = url
            captured["max_pages"] = max_pages
            return {"url": url, "pages": [], "issues": [], "site_score": 90.0, "grade": "A"}

    monkeypatch.setattr(audit_adapter, "_SEOExtract", FakeExtract)
