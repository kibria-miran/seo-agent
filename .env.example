# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Contact address shown in the honest crawler user agent (D-5).
SEO_AGENT_CONTACT=seo-agent@example.co.uk

# NVIDIA NIM key — only needed for agent mode (--agent).
# Without it, --no-llm still works fully.
NVIDIA_API_KEY=

# Optional. Path to a Google Search Console "Queries.csv" export.
# Unset means the source is skipped and logged as dep_unmet.
SEO_AGENT_GSC_CSV=

# Optional. Path to a CSV mapping queries to the pages that rank for them
# (a query,page two-column file, e.g. prepared from the free Search Console
# API with dimensions=query,page, or from per-page Queries exports).
# Unset means query→page attribution is skipped (dep_unmet).
SEO_AGENT_GSC_PAGES_CSV=

# Set to 1 to acknowledge crawling the placeholder demo profile shipped in
# profiles/site.json (fictional clearpath-mortgage.co.uk, FCA 123456).
# Only useful for dry runs; a real run should use your own profile values.
SEO_AGENT_ALLOW_DEMO_PROFILE=
